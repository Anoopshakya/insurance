# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase web client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# In Vercel, paste the complete private_key value. Both real line breaks and
# escaped \\n line breaks are accepted. Never prefix these server variables with NEXT_PUBLIC_.

# Notification provider webhooks
# Each webhook receives: { to, message, event: "partner_welcome" }
EMAIL_WEBHOOK_URL=
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
